# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.py]
max_line_length = 110

[*.{yml,yaml,toml,json,html,css,js}]
indent_size = 2

[*.md]
indent_size = 2
# a trailing double space is a line break in Markdown
trim_trailing_whitespace = false

[tests/fixtures/**]
# recorded responses are written by the test harness; leave them as they are
trim_trailing_whitespace = false
insert_final_newline = unset
