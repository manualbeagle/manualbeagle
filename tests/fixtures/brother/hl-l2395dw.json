   "text": "<div><tr><td><div class=\"wrap\"><div>\n<img src=\"/g/b/img/dltype4/pdf_1.gif\" width=\"29\" height=\"29\" alt=\"PDF\" title=\"PDF\" class=\"icon\"></div><div><em>Reference Guide</em></div>\n</div></td><td><div class=\"moreView\"><div class=\"type3comment\">Brief explanations for routine operations</div><!-- / .moreView --></div></td>\n\n<td class=\"text-center\"><em>03/14/2019<br>(B)</em></td><td class=\"text-center\">\n<a href=\"https://download.brother.com/welcome/doc100771/cv_mfcl2750dw_use_rg_b.pdf\" target=\"_blank\" class=\"mod-button button-m ManualToFileForGlobal\" onclick=\"analyticsSend(1, 'Manual To File','Reference Guide','https://download.brother.com/welcome/doc100771/cv_mfcl2750dw_use_rg_b.pdf','10186');\" urlwithnoparam=\"https://download.brother.com/welcome/doc100771/cv_mfcl2750dw_use_rg_b.pdf\">Download</a><br><em>(1.00MB)</em></td></tr>\n<tr><td><div class=\"wrap\"><div>\n<img src=\"/g/b/img/dltype4/pdf_1.gif\" width=\"29\" height=\"29\" alt=\"PDF\" title=\"PDF\" class=\"icon\"></div><div><em>Online User's Guide</em></div>\n</div></td><td><div class=\"moreView\"><div class=\"type3comment\">For learning the operations, routine maintenance, troubleshooting tips and some useful network features of your products.</div><!-- / .moreView --></div></td>\n\n<td class=\"text-center\"><em>01/14/2022<br>(G)</em></td><td class=\"text-center\">\n<a href=\"https://download.brother.com/welcome/doc100802/cv_mfcl2750dw_use_oug_g.pdf\" target=\"_blank\" class=\"mod-button button-m ManualToFileForGlobal\" onclick=\"analyticsSend(1, 'Manual To File','Online User\\'s Guide','https://download.brother.com/welcome/doc100802/cv_mfcl2750dw_use_oug_g.pdf','10186');\" urlwithnoparam=\"https://download.brother.com/welcome/doc100802/cv_mfcl2750dw_use_oug_g.pdf\">Download</a><br><em>(11.48MB)</em></td></tr>\n<tr><td><div class=\"wrap\"><div>\n<img src=\"/g/b/img/dltype4/pdf_1.gif\" width=\"29\" height=\"29\" alt=\"PDF\" title=\"PDF\" class=\"icon\"></div><div><em>Bro